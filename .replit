modules = ["nodejs-20", "python-3.11", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["imagemagick", "ghostscript", "poppler_utils", "pdf2svg", "librsvg", "inkscape", "jq", "zip"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["node", "dist/index.js"]

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "MALLOC_ARENA_MAX=2 NODE_OPTIONS='--max-old-space-size=384' npm run dev"
waitForPort = 5000

[[ports]]
localPort = 3333
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[agent]
integrations = ["dropbox:1.0.0", "github:1.0.0", "javascript_gemini_ai_integrations:2.0.0"]

[userenv]

[userenv.shared]
VITE_ODOO_CT_WEBSITE_ID = "3"
ADMIN_PASSWORD = "admin123"

[userenv.production]
NODE_ENV = "production"
NODE_OPTIONS = "--max-old-space-size=384 --expose-gc"
MALLOC_ARENA_MAX = "2"
