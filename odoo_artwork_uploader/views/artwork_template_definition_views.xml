<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_artwork_template_definition_tree" model="ir.ui.view">
        <field name="name">artwork.template.definition.tree</field>
        <field name="model">artwork.template.definition</field>
        <field name="arch" type="xml">
            <tree string="Template Definitions" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="template_id"/>
                <field name="name"/>
                <field name="category"/>
                <field name="width_mm"/>
                <field name="height_mm"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_artwork_template_definition_form" model="ir.ui.view">
        <field name="name">artwork.template.definition.form</field>
        <field name="model">artwork.template.definition</field>
        <field name="arch" type="xml">
            <form string="Template Definition">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"
                                   options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    <group>
                        <group string="Template Information">
                            <field name="name"/>
                            <field name="template_id"/>
                            <field name="category"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Dimensions">
                            <field name="width_mm"/>
                            <field name="height_mm"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Additional information about this template..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_artwork_template_definition_search" model="ir.ui.view">
        <field name="name">artwork.template.definition.search</field>
        <field name="model">artwork.template.definition</field>
        <field name="arch" type="xml">
            <search string="Search Templates">
                <field name="name"/>
                <field name="template_id"/>
                <field name="category"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="group_category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_artwork_template_definition" model="ir.actions.act_window">
        <field name="name">Template Definitions</field>
        <field name="res_model">artwork.template.definition</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_artwork_template_definition_search"/>
        <field name="context">{'search_default_active': 1, 'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first template definition
            </p>
            <p>
                Template definitions allow you to manage the available artwork templates.
                Each template can be mapped to a product for automatic cart integration.
            </p>
            <p>
                <b>Template ID</b>: The unique identifier used by the artwork uploader app (e.g., "template-A3")<br/>
                <b>Name</b>: The display name shown to users (e.g., "A3 Full Colour")
            </p>
        </field>
    </record>

    <!-- Server Action to Initialize Default Templates -->
    <record id="action_init_default_templates" model="ir.actions.server">
        <field name="name">Initialize Default Templates</field>
        <field name="model_id" ref="model_artwork_template_definition"/>
        <field name="state">code</field>
        <field name="code">
model.init_default_templates()
action = {
    'type': 'ir.actions.client',
    'tag': 'display_notification',
    'params': {
        'title': 'Templates Initialized',
        'message': 'Default artwork templates have been created.',
        'type': 'success',
        'sticky': False,
    }
}
        </field>
    </record>
</odoo>
