<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend Sale Order Line Form View to Show Artwork PDF and Details -->
        <record id="view_order_form_artwork_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.artwork.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <!-- Add artwork details to order line tree view -->
                <xpath expr="//field[@name='order_line']/tree/field[@name='name']" position="after">
                    <field name="artwork_pdf_filename" string="Artwork" optional="show"/>
                    <field name="artwork_garment_colors" string="Garment Colors" optional="show"/>
                    <field name="artwork_comment" string="Comments" optional="show"/>
                </xpath>
                
                <!-- Add artwork fields to order line form view -->
                <xpath expr="//field[@name='order_line']/form//field[@name='product_uom_qty']" position="after">
                    <group string="Artwork Details" attrs="{'invisible': [('artwork_project_id', '=', False)]}">
                        <field name="artwork_project_id" readonly="1"/>
                        <field name="artwork_pdf_file" filename="artwork_pdf_filename" widget="binary"/>
                        <field name="artwork_pdf_filename" invisible="1"/>
                        <field name="artwork_garment_colors" readonly="1"/>
                        <field name="artwork_comment" readonly="1"/>
                    </group>
                </xpath>
            </field>
        </record>
        
        <!-- Tree view for Sale Order Lines showing artwork details -->
        <record id="view_order_line_tree_artwork" model="ir.ui.view">
            <field name="name">sale.order.line.tree.artwork</field>
            <field name="model">sale.order.line</field>
            <field name="inherit_id" ref="sale.view_order_line_tree"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="artwork_pdf_filename" string="Artwork PDF" optional="show"/>
                    <field name="artwork_garment_colors" string="Garment Colors" optional="show"/>
                    <field name="artwork_comment" string="Comments" optional="show"/>
                </field>
            </field>
        </record>
        
        <!-- Form view for Sale Order Lines showing full artwork details -->
        <record id="view_order_line_form2_artwork" model="ir.ui.view">
            <field name="name">sale.order.line.form2.artwork</field>
            <field name="model">sale.order.line</field>
            <field name="inherit_id" ref="sale.view_order_line_form2"/>
            <field name="arch" type="xml">
                <group name="order_line_details" position="after">
                    <group string="Artwork Details" attrs="{'invisible': [('artwork_project_id', '=', False)]}">
                        <field name="artwork_project_id" readonly="1"/>
                        <field name="artwork_pdf_file" filename="artwork_pdf_filename" widget="binary"/>
                        <field name="artwork_pdf_filename" invisible="1"/>
                        <field name="artwork_garment_colors" readonly="1" widget="text"/>
                        <field name="artwork_comment" readonly="1" widget="text"/>
                    </group>
                </group>
            </field>
        </record>
    </data>
</odoo>
