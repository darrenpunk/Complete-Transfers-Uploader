<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Main Upload Page Template -->
        <template id="upload_page" name="Artwork Uploader">
            <t t-call="website.layout">
                <div id="wrap" class="oe_structure">
                    <div class="container-fluid artwork-uploader-container" style="padding: 0; margin: 0; height: calc(100vh - 100px);">
                        <iframe 
                            src="https://9e65605c-2a89-4d92-87e7-b0473609432c-00-w27t8e2xc951.spock.replit.dev"
                            style="width: 100%; height: 100%; border: none; display: block;"
                            title="Proof Designer - Artwork Uploader"
                            allow="clipboard-write">
                        </iframe>
                    </div>
                </div>
            </t>
        </template>

        <!-- Add to Website Menu -->
        <record id="menu_artwork_uploader" model="website.menu">
            <field name="name">Design Tool</field>
            <field name="url">/artwork/upload</field>
            <field name="parent_id" ref="website.main_menu"/>
            <field name="sequence">50</field>
        </record>

    </data>
</odoo>